+int g_page = 64;                  // the tokens of a page that page selection keeps or drops whole (--kv-page)
+
+/// The key bounds of the pages [pg0, pg1] from the VRAM cache (which still holds every cell of them).
+__global__ void k_page_sum(Kv c, int pg0, int pmax, int pg_len) {
+    const int page = pg0 + blockIdx.x, kh = blockIdx.y, i = threadIdx.x;
+    const int a = page * pg_len, b = min(a + pg_len - 1, pmax);
+    float mn = INFINITY, mx = -INFINITY;
+    for (int kp = a; kp <= b; ++kp) {
+        const size_t ro = (size_t) kh * c.cells + (c.ring > 0 ? kp % c.ring : kp);
+        const float x = (float) ((const int8_t*) c.k)[ro * kHD + i] * c.ks[ro];
+        mn = fminf(mn, x);
+        mx = fmaxf(mx, x);
+    }
+    const size_t o = ((size_t) kh * c.npages + page) * kHD + i;
+    c.pmn[o] = __float2half_rd(mn);
+    c.pmx[o] = __float2half_ru(mx);
+}
+
+/// Each page's upper bound on q.k * scale over a KV head's query heads (Quest), a warp a page; page 0 always kept.
+__global__ void __launch_bounds__(256) k_page_score(const float* q, Kv c, int np, int t0, int H, int G, float scale,
+                                                    float* out) {
+    __shared__ float qs[kMaxG][kHD];
+    const int kh = blockIdx.y, row = blockIdx.z, t = t0 + row;
+    for (int i = threadIdx.x; i < G * kHD; i += blockDim.x) qs[i / kHD][i % kHD] = q[((size_t) t * H + kh * G + i / kHD) * kHD + i % kHD];
+    __syncthreads();
+    const int warp = threadIdx.x / 32, lane = threadIdx.x % 32, page = blockIdx.x * 8 + warp;
+    if (page >= np) return;
+    const size_t o = ((size_t) kh * c.npages + page) * kHD + lane * 4;
+    const uint2 un = *reinterpret_cast<const uint2*>(c.pmn + o), ux = *reinterpret_cast<const uint2*>(c.pmx + o);
+    const float2 n0 = __half22float2(*reinterpret_cast<const __half2*>(&un.x)), n1 = __half22float2(*reinterpret_cast<const __half2*>(&un.y));
+    const float2 x0 = __half22float2(*reinterpret_cast<const __half2*>(&ux.x)), x1 = __half22float2(*reinterpret_cast<const __half2*>(&ux.y));
+    const float mn[4] = {n0.x, n0.y, n1.x, n1.y}, mx[4] = {x0.x, x0.y, x1.x, x1.y};
+    float best = -INFINITY;
+    for (int g = 0; g < G; ++g) {
+        float b = 0.f;
+#pragma unroll
+        for (int e = 0; e < 4; ++e) {
+            const float qv = qs[g][lane * 4 + e];
+            b += fmaxf(qv * mn[e], qv * mx[e]);
+        }
+        for (int off = 16; off > 0; off >>= 1) b += __shfl_xor_sync(0xffffffffu, b, off);
+        best = fmaxf(best, b * scale);
+    }
+    if (lane == 0) out[((size_t) row * gridDim.y + kh) * np + page] = page == 0 ? INFINITY : best;
+}
+
+__device__ __forceinline__ uint32_t order_key(float f) {
+    const uint32_t u = __float_as_uint(f);
+    return (u & 0x80000000u) ? ~u : (u | 0x80000000u);
+}
+
+/// The nsel best pages of each (row, KV head), in page order (ties by page), or all of them when np <= nsel.
+__global__ void __launch_bounds__(256) k_page_topk(const float* score, int np, int nsel, int32_t* sel) {
+    __shared__ int sh[kThreads], wsum[8], tot;
+    const int r = blockIdx.x, tid = threadIdx.x, warp = tid / 32, lane = tid % 32;
+    const float* sc = score + (size_t) r * np;
+    int32_t* out = sel + (size_t) r * nsel;
+    if (np <= nsel) {
+        for (int i = tid; i < np; i += blockDim.x) out[i] = i;
+        return;
+    }
+    uint32_t T = 0;
+    for (int bit = 31; bit >= 0; --bit) {   // the largest T with at least nsel keys >= T: the nsel-th key
+        const uint32_t cand = T | (1u << bit);
+        int n = 0;
+        for (int i = tid; i < np; i += blockDim.x) n += order_key(sc[i]) >= cand;
+        if (block_sum((float) n, (float*) sh) >= (float) nsel) T = cand;
+        __syncthreads();
+    }
+    int base = 0;
+    for (int pass = 0; pass < 2; ++pass) {   // the keys above T, then those equal to it while there is room
+        for (int i0 = 0; i0 < np && base < nsel; i0 += blockDim.x) {
+            const int i = i0 + tid;
+            const uint32_t k = i < np ? order_key(sc[i]) : 0u;
+            const bool f = i < np && (pass == 0 ? k > T : k == T);
+            const unsigned bal = __ballot_sync(0xffffffffu, f);
+            if (lane == 0) wsum[warp] = __popc(bal);
+            __syncthreads();
+            int off = 0;
+            for (int w = 0; w < warp; ++w) off += wsum[w];
+            const int at = base + off + __popc(bal & ((1u << lane) - 1u));
+            if (f && at < nsel) out[at] = i;
+            if (tid == 0) {
+                int s2 = 0;
+                for (int w = 0; w < 8; ++w) s2 += wsum[w];
+                tot = s2;
+            }
+            __syncthreads();
+            base += tot;
+            __syncthreads();
+        }
+    }
+    // the selected pages in page order across both passes
+    __syncthreads();
+    if (tid == 0) {
+        int n = min(base, nsel);
+        for (int a = 1; a < n; ++a) {   // insertion sort: the second pass's few ties into the first's order
+            const int32_t v = out[a];
+            int b = a - 1;
+            while (b >= 0 && out[b] > v) { out[b + 1] = out[b]; --b; }
+            out[b + 1] = v;
+        }
+    }
+}
