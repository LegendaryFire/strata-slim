+/// A draw from d, leaving out `skip` (the drafted token a verify turned down: the rest renormalized).
+int draw(const Dist& d, std::mt19937_64& rng, int skip = -1) {
+    double tot = 0;
+    for (size_t i = 0; i < d.idx.size(); ++i) tot += d.idx[i] == skip ? 0.0 : d.p[i];
