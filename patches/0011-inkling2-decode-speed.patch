+/// A looped layer's controls for a decode's rows, up to 3 at once (blockIdx.z): (1) each (row, control) block takes
+/// both inputs' RMS scales and 8 rows of the down projection of [x, msg] (a warp a row); (2) a warp two outputs of the
+/// gain and forget projections (R inputs) and the mix (1 - tanh f) x + tanh g msg.
+struct CtlArgs {
+    const float *x[3], *msg[3], *wd[3], *wg[3], *wf[3];
+    float* out[3];
+};
+__global__ void __launch_bounds__(256) k_ctl_down(CtlArgs a, float* h, int n, int R, float eps) {
+    __shared__ float sh[kThreads];
+    const int t = blockIdx.y, j = blockIdx.z, warp = threadIdx.x / 32, lane = threadIdx.x % 32;
+    const float* xr = a.x[j] + (size_t) t * n;
+    const float* mr = a.msg[j] + (size_t) t * n;
+    float sx = 0.f, sm = 0.f;
+    for (int i = threadIdx.x; i < n; i += blockDim.x) sx += xr[i] * xr[i];
+    sx = block_sum(sx, sh);
+    for (int i = threadIdx.x; i < n; i += blockDim.x) sm += mr[i] * mr[i];
+    sm = block_sum(sm, sh);
+    const float rx = rsqrtf(sx / (float) n + eps), rm = rsqrtf(sm / (float) n + eps);
+    const int o = blockIdx.x * 8 + warp;
+    if (o >= R) return;
+    const float4* w4 = reinterpret_cast<const float4*>(a.wd[j] + (size_t) o * 2 * n);
+    float acc = 0.f;
+    for (int i = lane; i < 2 * n / 4; i += 32) {
+        const float4 w = w4[i];
+        const int e = i * 4;
+        const float4 v = e < n ? *reinterpret_cast<const float4*>(xr + e) : *reinterpret_cast<const float4*>(mr + e - n);
+        const float r = e < n ? rx : rm;
+        acc += w.x * (v.x * r) + w.y * (v.y * r) + w.z * (v.z * r) + w.w * (v.w * r);
+    }
+    for (int m = 16; m > 0; m >>= 1) acc += __shfl_xor_sync(0xffffffffu, acc, m);
+    if (lane == 0) h[((size_t) j * gridDim.y + t) * R + o] = acc;
+}
+__global__ void __launch_bounds__(256) k_ctl_up(CtlArgs a, const float* h, int n, int R) {
+    const int t = blockIdx.y, j = blockIdx.z, warp = threadIdx.x / 32, lane = threadIdx.x % 32;
+    const int half = lane / 16, l16 = lane % 16;          // a half-warp a row: R / 4 float4 (R <= 64)
+    const int i = (blockIdx.x * 8 + warp) * 2 + half;
+    const float* hr = h + ((size_t) j * gridDim.y + t) * R;
+    float g = 0.f, f = 0.f;
+    if (i < n && l16 < R / 4) {
+        const float4 hv = reinterpret_cast<const float4*>(hr)[l16];
+        const float4 wg = reinterpret_cast<const float4*>(a.wg[j] + (size_t) i * R)[l16];
+        const float4 wf = reinterpret_cast<const float4*>(a.wf[j] + (size_t) i * R)[l16];
+        g = wg.x * hv.x + wg.y * hv.y + wg.z * hv.z + wg.w * hv.w;
+        f = wf.x * hv.x + wf.y * hv.y + wf.z * hv.z + wf.w * hv.w;
+    }
+    for (int m = 8; m > 0; m >>= 1) {
+        g += __shfl_xor_sync(0xffffffffu, g, m);
+        f += __shfl_xor_sync(0xffffffffu, f, m);
+    }
+    if (i < n && l16 == 0) {
+        const size_t o = (size_t) t * n + i;
+        a.out[j][o] = (1.0f - tanhf(f)) * a.x[j][o] + tanhf(g) * a.msg[j][o];
+    }
+}
