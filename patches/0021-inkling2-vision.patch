+                int32_t id = kImgId0 | (int32_t) (fnv(&j, sizeof j, key) & 0x3FFFFFFF);
+                while (img->at.count(id)) id = kImgId0 | ((id + 1) & 0x3FFFFFFF);   // (a row the same key and row gave twice)
