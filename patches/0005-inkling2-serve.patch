             ids.add(int(got[0]))
+    specials = getattr(tokenizer, "special_ids", None) or {}
     if not ids:
-        eos = (getattr(tokenizer, "special_ids", None) or {}).get("eos")
+        eos = specials.get("eos")
         if eos is not None:
             ids.add(int(eos))
