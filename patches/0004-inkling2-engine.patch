+                for (int kk = 0; kk < kTK; kk += 16) {
+                    wmma::fragment<wmma::matrix_a, 16, 16, 16, __half, wmma::row_major> af;
+                    wmma::fragment<wmma::matrix_b, 16, 16, 16, __half, wmma::row_major> bf;
+                    wmma::load_matrix_sync(af, Ps + i * 16 * kSLd + kk, kSLd);
+                    wmma::load_matrix_sync(bf, Vs + kk * kQLd + warp * 16, kQLd);
+                    wmma::mma_sync(oacc[i], af, bf, oacc[i]);
+                }
+            }
+        }
+    }
+#pragma unroll
+    for (int i = 0; i < RW; ++i) {
+        const int r = warp + 8 * i;
+        if (lane == 0 && r < rows) {
+            ls[r] = lr[i];
+            ms[r] = mr[i];
+            mo[r] = m0[i];
+        }
+    }
+    __syncthreads();
+#pragma unroll
+    for (int i = 0; i < 3; ++i) wmma::store_matrix_sync(Of + i * 16 * (kHD + 4) + warp * 16, oacc[i], kHD + 4, wmma::mem_row_major);
+    __syncthreads();
+    for (int i = tid; i < rows * kHD; i += 256) {
+        const int r = i / kHD, d = i % kHD;
+        const int t = t0 + r / G, h = kvh * G + r % G;
+        const size_t row = (size_t) t * H + h, o = row * kHD + d;
+        const float f = first ? 0.f : expf(mo[r] - ms[r]);
+        const float ov = Of[r * (kHD + 4) + d] + (first ? 0.f : run_o[o] * f);
+        const float lv = ls[r] + (first ? 0.f : run_l[row] * f);
+        if (last) {
+            out[o] = ov / (lv + expf(sink[row] - ms[r])) * sigm(gate[o]);
+        } else {
+            run_o[o] = ov;
+            if (d == 0) {
+                run_m[row] = ms[r];
+                run_l[row] = lv;
+            }
+        }
+    }
+}
