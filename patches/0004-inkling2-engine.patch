+constexpr int kTQ = 16, kTK = 32, kQLd = kHD + 8, kSLd = kTK + 8, kRLd = 24, kTLd = 52, kMRows = 48;
+constexpr size_t kAttMmaSmem = (size_t) kMRows * kQLd * 2 + (size_t) 2 * kTK * kQLd * 2 + (size_t) kMRows * kSLd * 4 +
+                               (size_t) kMRows * kSLd * 2 + (size_t) 2 * kMRows * kRLd * 2 + (size_t) kMRows * kTLd * 4 +
+                               (size_t) 3 * kMRows * 4;
+template <bool Q8>
+__global__ void __launch_bounds__(256) k_attn_mma(const float* q, const float* rr, KvSrc src,
