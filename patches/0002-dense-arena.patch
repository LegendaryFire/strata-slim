+class DenseArena {
+public:
+    DenseArena() = default;
+    DenseArena(const DenseArena&) = delete;
+    DenseArena& operator=(const DenseArena&) = delete;
+    ~DenseArena() { close(); }
+    bool open() {
+        size_t free_b = 0, total_b = 0;
+        if (cudaMemGetInfo(&free_b, &total_b) != cudaSuccess || total_b == 0 || !range_.reserve(total_b)) {
+            (void) cudaGetLastError();
+            return false;
+        }
+        gran_ = vmm_granularity();
+        std::lock_guard<std::mutex> lock(g_arena_mu);
+        g_arena_spans.emplace_back((uintptr_t) range_.base(), (uintptr_t) range_.base() + (uintptr_t) range_.chunks() * gran_);
+        return true;
+    }
+    void close() {
+        if (range_.base() == nullptr) return;
+        {
+            std::lock_guard<std::mutex> lock(g_arena_mu);
+            const uintptr_t base = (uintptr_t) range_.base();
+            g_arena_spans.erase(std::remove_if(g_arena_spans.begin(), g_arena_spans.end(),
+                                               [&](const auto& span) { return span.first == base; }),
+                                g_arena_spans.end());
+        }
+        range_.release();
+    }
+    void* take(uint64_t bytes) {
+        if (bytes == 0 || gran_ == 0) return nullptr;
+        const uint64_t at = arena_bytes(used_);
+        const int64_t need = (int64_t) ((at + bytes + gran_ - 1) / gran_);
+        if (need > range_.chunks()) return nullptr;
+        if (!range_.map_range(range_.mapped_count(), need, [] { return (VmmChunk) 0; })) {
+            (void) cudaGetLastError();
+            return nullptr;
+        }
+        used_ = at + bytes;
+        return range_.base() + at;
+    }
+    uint64_t used() const { return used_; }
+    uint64_t mapped() const { return (uint64_t) range_.mapped_count() * gran_; }
+
+private:
+    VmmRange range_;
+    uint64_t gran_ = 0;
+    uint64_t used_ = 0;
+};
