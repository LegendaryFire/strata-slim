+    const float rx = rsqrtf(sx / (float) n + eps), rm = rsqrtf(sm / (float) n + eps);
     float g = 0.f, f = 0.f;
     if (i < n && l16 < R / 4) {
-        const float4 hv = reinterpret_cast<const float4*>(hr)[l16];
+        float4 hv = make_float4(0.f, 0.f, 0.f, 0.f);
