+            hv.y += p.y * r;
+            hv.z += p.z * r;
+            hv.w += p.w * r;
+        }
         const float4 wg = reinterpret_cast<const float4*>(a.wg[j] + (size_t) i * R)[l16];
         const float4 wf = reinterpret_cast<const float4*>(a.wf[j] + (size_t) i * R)[l16];
         g = wg.x * hv.x + wg.y * hv.y + wg.z * hv.z + wg.w * hv.w;
@@ -3307,6 +3377,7 @@ struct Dev {
