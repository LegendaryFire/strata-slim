# strata-slim settings. Copy to .env (`cp example.env .env`), edit, then `docker compose up -d`.
# One setting per line, no quotes needed. Lines starting with # are off. This file lists every variable there is;
# the ones left off (#) have the default their comment gives.

# =================================================================================================================
# Docker Compose (the host side)
# =================================================================================================================

# nvidia or amd: which image and GPU access to use
COMPOSE_PROFILES=nvidia

# Folders on this machine. MODELS_PATH needs room for the model and its pack (100+ GB for Qwen3.8-Flash-Next).
MODELS_PATH=./models
DATA_PATH=./data

# The API is at http://localhost:8080. LISTEN=0.0.0.0 opens it to your network: set API_KEY below then.
HOST_PORT=8080
LISTEN=127.0.0.1

# Image build (`docker compose build`). Fewer architectures build faster.
#   NVIDIA, CUDA_ARCHITECTURES: 86 = RTX 30, 89 = RTX 40, 120 = RTX 50; several: 86;89
#   AMD, HIP_ARCHITECTURES: gfx1100 = RX 7900, gfx1101 = RX 7800/7700, gfx1201 = RX 9070, gfx1200 = RX 9060
CUDA_ARCHITECTURES=86
# HIP_ARCHITECTURES=gfx1201
# Parallel compile jobs: each can take several GB of RAM.
BUILD_JOBS=4

# =================================================================================================================
# The model (downloaded and prepared on the first start, then reused)
# =================================================================================================================

# The Hugging Face repository and quantization. A wrong MODEL_QUANT lists the ones the repository has.
MODEL_REPO=unsloth/Qwen3.8-Flash-Next-GGUF
MODEL_QUANT=UD-Q4_K_XL
# Pictures need an mmproj file: from this repository (default: MODEL_REPO)
MMPROJ_REPO=ISTA-DASLab/Qwen3.8-Flash-Next-GSQ-RCO-GGUF
# For gated or private repositories:
# HF_TOKEN=
# The commit or branch of the first download (default main). After it, the folder keeps that version
# (<model folder>/.source.json); another version goes into a new folder.
# MODEL_REVISION=
# A Hugging Face mirror
# HF_ENDPOINT=https://huggingface.co

# Pack flags: --compat-bf16 for Unsloth's UD-* files
PACK_ARGS=--compat-bf16

# Drafter (speeds up generation): mtp (default), dflash2, auto or off
DRAFTER=mtp
# The MTP layer's expert quantization (default q2_0)
# MTP_EXPERTS=q2_0
# The draft token subset: cjk (default), en, cyrillic or fr
# DRAFT_VOCAB=cjk

# The name clients see in /v1/models (default: from the file name)
MODEL_NAME=qwen3.8-flash-next-unsloth-ud-q4_k_xl

# =================================================================================================================
# Engine
# =================================================================================================================

# Context length (k = 1024) and KV cache type
CONTEXT=256k
KV=int8
# VRAM kept free for other programs, in MiB
VRAM_RESERVE_MIB=550

# GPUs: card numbers, or unset for the default (NVIDIA: as nvidia-smi numbers them; AMD: picked automatically)
GPUS=0,1
CONFIG_LAYER_SPLIT=auto

# Every other engine flag, as on a command line (tuned for two RTX 3060s; remove it to use the engine's defaults)
ENGINE_ARGS=--expert-cache auto --prefill auto --spec 4 --spec-min-p 0.70 --kv-resident 32768 --pcie-frac 0.00 --adapt-every 1 --adapt-swaps 80 --adapt-decay 0.97

# Engine switches: STRATA_* variables reach the engine unchanged
STRATA_HC_Q8=1
STRATA_ROUTE_TAIL_SKIP=0
STRATA_EXCHANGE_ROTATE=1

# =================================================================================================================
# Pictures
# =================================================================================================================

# off, cpu or gpu
VISION=cpu
# The mmproj file (default: the one mmproj*.gguf in or beside the model folder, downloaded from MMPROJ_REPO if none)
# MMPROJ=/models/models/mmproj-Qwen3.8-Flash-Next-BF16.gguf
VISION_THREADS=8
VISION_MAX_TOKENS=300

# =================================================================================================================
# Server
# =================================================================================================================

# The key clients send (Authorization: Bearer ...). Unset: no key, so keep the port private.
# API_KEY=
# Or read it from a file (a Docker secret, for example)
# API_KEY_FILE=/run/secrets/strata_api_key
# More serve.server flags
# SERVER_ARGS=--parallel 2
# Behind a reverse proxy without an API key: the host names the server may be reached by
# STRATA_ALLOWED_HOSTS=llm.example.com

# =================================================================================================================
# Any other setting of the server's run config
# =================================================================================================================

# CONFIG_<KEY>=<value> sets config key <key> (lowercase), like CONFIG_LAYER_SPLIT in Engine above. The value is
# JSON when it parses as JSON, else a string. A key the server does not read is a warning.
# CONFIG_IDLE_UNLOAD_S=600
# Engine switches: any STRATA_*, FNX_* or DS4_* variable reaches the engine unchanged (see Engine above).

# =================================================================================================================
# Inside the container: compose.yaml expects the defaults, so leave these off unless you mount things differently
# =================================================================================================================

# auto (default): download and prepare what is missing before the server starts; off: never
# PREPARE=auto
# The models root (default /models): models/<owner>-<quant>/, packs/<owner>-<quant>/, mtp/rt/, dflash2/
# MODELS_DIR=/models
# Instead of the derived folders: the model's GGUF (a file, or a folder of shards) and its pack
# MODEL_GGUF=
# PACK=
# The tokenizer (default <pack>/tokenizer) and the expert profile (default the shipped one; none: no profile)
# TOKENIZER=
# EXPERT_PROFILE=
# The server's address inside the container (compose.yaml publishes port 8080)
# HOST=0.0.0.0
# PORT=8080
# Where the config and the engine log go
# CONFIG_OUT=/data/run/config.json
# LOG_FILE=/data/logs/engine.log
# How much strata-slim itself logs before the server starts: DEBUG, INFO, WARNING or ERROR
# LOG_LEVEL=INFO
# An env file read at start, for running without compose's env_file (variables already set win over it)
# ENV_FILE=/data/.env
