# strata-slim env file: the 0.1.45 setup (strata/data/config/strata-unsloth-ud-q4_k_xl.json), one variable per
# setting. Paths are inside the container; see README.md for the matching volume mounts.

# ---- download: what is missing is fetched and checked by SHA-256. The first download records its commit in
# <model folder>/.source.json, so later starts keep exactly these files (a folder downloaded earlier is adopted).
MODEL_REPO=unsloth/Qwen3.8-Flash-Next-GGUF
MODEL_QUANT=UD-Q4_K_XL
MMPROJ_REPO=ISTA-DASLab/Qwen3.8-Flash-Next-GSQ-RCO-GGUF
# HF_TOKEN=

# ---- drafter: mtp (default) | dflash2 | auto | off
# dflash2: the DFlash2 block drafter instead of the MTP layer (1.2 GB download, one request at a time; upstream
# measured it slower than MTP on RTX 30 cards). The MTP layer is then not built or used.
DRAFTER=mtp

# ---- pack and MTP draft layer (built when missing)
# Where everything goes follows from the above, under /models:
#   models/unsloth-UD-Q4_K_XL/   packs/unsloth-ud-q4_k_xl/   mtp/rt/
# (MODELS_DIR, MODEL_GGUF and PACK change that.)
PACK_ARGS=--compat-bf16

# ---- the name clients see in /v1/models
MODEL_NAME=qwen3.8-flash-next-unsloth-ud-q4_k_xl

# ---- engine
CONTEXT=256k
KV=int8
VRAM_RESERVE_MIB=550
ENGINE_ARGS=--expert-cache auto --prefill auto --spec 4 --spec-min-p 0.70 --kv-resident 32768 --pcie-frac 0.00 --adapt-every 1 --adapt-swaps 80 --adapt-decay 0.97

# engine switches (read by the engine itself)
STRATA_HC_Q8=1
STRATA_ROUTE_TAIL_SKIP=0
STRATA_EXCHANGE_ROTATE=1

# ---- GPUs (both cards, layer split chosen by the engine)
GPUS=0,1
CONFIG_LAYER_SPLIT=auto

# ---- pictures (the reader on the CPU; the mmproj beside the model folder is found by itself)
VISION=cpu
VISION_THREADS=8
VISION_MAX_TOKENS=300

# ---- server
# STRATA_ALLOWED_HOSTS=llm.example.com
# API_KEY=
